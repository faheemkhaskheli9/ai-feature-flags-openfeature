{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Show example flags",
      "type": "debugpy",
      "request": "launch",
      "module": "ai_feature_flags.cli",
      "args": ["show-examples"],
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONPATH": "${workspaceFolder}/src" },
      "console": "integratedTerminal"
    },
    {
      "name": "Validate: example flag file",
      "type": "debugpy",
      "request": "launch",
      "module": "ai_feature_flags.cli",
      "args": ["validate", "examples/flags/rag_enabled.json"],
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONPATH": "${workspaceFolder}/src" },
      "console": "integratedTerminal"
    },
    {
      "name": "Pytest: all tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests/", "-v"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
